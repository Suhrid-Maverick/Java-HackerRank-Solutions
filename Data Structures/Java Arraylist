import java.io.*;
import java.util.*;

public class Solution {
    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        StringBuilder sb = new StringBuilder();

        int n = Integer.parseInt(br.readLine().trim());
        ArrayList<ArrayList<Integer>> lists = new ArrayList<>(n);

        for (int i = 0; i < n; i++) {
            StringTokenizer st = new StringTokenizer(br.readLine());
            int d = Integer.parseInt(st.nextToken());
            ArrayList<Integer> row = new ArrayList<>(d);
            for (int j = 0; j < d; j++) {
                row.add(Integer.parseInt(st.nextToken()));
            }
            lists.add(row);
        }

        int q = Integer.parseInt(br.readLine().trim());
        while (q-- > 0) {
            StringTokenizer st = new StringTokenizer(br.readLine());
            int x = Integer.parseInt(st.nextToken()) - 1;   // 1-based -> 0-based
            int y = Integer.parseInt(st.nextToken()) - 1;

            if (x >= 0 && x < lists.size() && y >= 0 && y < lists.get(x).size()) {
                sb.append(lists.get(x).get(y)).append('\n');
            } else {
                sb.append("ERROR!\n");
            }
        }

        System.out.print(sb);
    }
}
